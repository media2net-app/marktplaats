# API Configuration
# Voor lokale ontwikkeling:
API_BASE_URL=http://localhost:3000
# Voor productie:
# API_BASE_URL=https://marktplaats-eight.vercel.app

# Deze moet overeenkomen met INTERNAL_API_KEY in je .env.local
INTERNAL_API_KEY=internal-key-change-in-production

# Marktplaats Configuration
MARKTPLAATS_BASE_URL=https://www.marktplaats.nl

# Browser session directory (houdt je login bij)
# Standaard: ~/.marktplaats_browser
USER_DATA_DIR=~/.marktplaats_browser

# Media root (waar je foto's staan)
# Standaard: ../public/media
MEDIA_ROOT=../public/media

# Optioneel: vertraag acties voor stabiliteit (in ms)
ACTION_DELAY_MS=200

# Optioneel: headless mode (true/false)
# HEADLESS=false  # Laat browser open voor debugging
